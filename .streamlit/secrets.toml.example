# Streamlit Community Cloud Secrets Configuration Template
# In Streamlit Community Cloud: Go to App Settings -> Secrets -> Paste these settings:
#
# DO NOT commit real API keys to git. Keep this template safe.

GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.8-flash"
GEMINI_MAX_CONCURRENCY = 3
GEMINI_REQUEST_TIMEOUT = 90.0

