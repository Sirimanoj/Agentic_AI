# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Default: gemini-3.8-flash; Supported: gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-pro-preview, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Concurrency & Timeout Configuration
GEMINI_MAX_CONCURRENCY=3
GEMINI_REQUEST_TIMEOUT=90.0
